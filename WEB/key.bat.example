@echo off
rem ---------------------------------------------------------------
rem  Template for key.bat.
rem
rem  How to use:
rem    1. Copy this file to key.bat (same folder).
rem    2. Put your real key on the A6API_KEY line below.
rem    3. Launch with 启动.bat -- it loads key.bat automatically.
rem
rem  key.bat is listed in .gitignore, so your key stays on this
rem  machine and never reaches GitHub. Do NOT rename it to a
rem  tracked name, and do NOT paste your key into a .py file.
rem
rem  Your key comes from your API provider's console and looks
rem  like sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.
rem ---------------------------------------------------------------

set A6API_KEY=sk-put-your-own-key-here
